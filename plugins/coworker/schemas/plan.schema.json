{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "assessment",
    "summary",
    "approach",
    "limitations",
    "prior",
    "items",
    "questions"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "approve_with_changes",
        "revise",
        "rethink",
        "inconclusive"
      ]
    },
    "assessment": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unable"
      ]
    },
    "summary": {
      "type": "string"
    },
    "approach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "reason",
        "alternative"
      ],
      "properties": {
        "assessment": {
          "type": "string",
          "enum": [
            "sound",
            "questionable",
            "wrong"
          ]
        },
        "reason": {
          "type": "string"
        },
        "alternative": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prior": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "new_severity",
          "reason",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "fixed_verified",
              "fix_incomplete",
              "conceded",
              "maintained",
              "downgraded",
              "superseded",
              "accepted_deferral"
            ]
          },
          "new_severity": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "blocker",
              "major",
              "minor",
              null
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "severity",
          "section",
          "title",
          "problem",
          "suggestion",
          "evidence",
          "basis",
          "confidence",
          "verify_by"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "enum": [
              "verified",
              "inferred"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "verify_by": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "issue",
              "missing",
              "risk"
            ]
          },
          "section": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "to",
          "blocking",
          "text"
        ],
        "properties": {
          "to": {
            "type": "string",
            "enum": [
              "claude",
              "user"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
